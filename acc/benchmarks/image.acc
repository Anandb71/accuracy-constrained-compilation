// Image kernel: 3x3 convolution followed by a sigmoid contrast curve.
kernel image {
  budget 1e-2;
  input img[12, 12] in [0, 1];
  input k[3, 3] in [0, 0.125];
  output out[10, 10];

  for i in 0..10 {
    for j in 0..10 {
      let s = 0;
      for di in 0..3 {
        for dj in 0..3 {
          s += k[di, dj] * img[i + di, j + dj];
        }
      }
      out[i, j] = sigmoid(8 * (s - 0.5));
    }
  }
}
