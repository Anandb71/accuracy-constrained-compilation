// Dense layer inference: y = tanh(W x + b).
kernel dense {
  budget 1e-2;
  input x[32] in [-1, 1];
  input W[16, 32] in [-0.125, 0.125];
  input b[16] in [-0.5, 0.5];
  output y[16];

  for i in 0..16 {
    let acc = b[i];
    for k in 0..32 {
      acc += W[i, k] * x[k];
    }
    y[i] = tanh(acc);
  }
}
