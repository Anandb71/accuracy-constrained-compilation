// Newton iteration for 1/sqrt(a): y <- y (1.5 - 0.5 a y^2).
// A long nonlinear chain: the stress test for affine bounds.
kernel newton {
  budget 1e-3;
  input a[32] in [1, 4];
  output r[32];

  for i in 0..32 {
    let y = 0.7;
    for it in 0..4 {
      y = y * (1.5 - 0.5 * a[i] * y * y);
    }
    r[i] = y;
  }
}
